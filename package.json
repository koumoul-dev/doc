{
  "name": "@koumoul/doc",
  "version": "0.6.2",
  "description": "Preview and export professional A4 documents from markdown",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "koumoul-doc": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "index.html"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "dev": "node src/cli/index.ts dev examples/example.md",
    "dev:letterhead": "node src/cli/index.ts dev examples/letterhead.md",
    "lint": "eslint",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/unit/**/*.test.ts",
    "test:e2e": "playwright test",
    "quality": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "cac": "^7.0.0",
    "js-yaml": "^4.3.2",
    "markdown-it": "^15.0.2",
    "markdown-it-container": "^4.0.0",
    "mermaid": "^12.2.0",
    "puppeteer": "^25.13.0",
    "shiki": "^4.0.2",
    "unocss": "^66.6.7",
    "vite": "^6.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.58.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "neostandard": "^0.14.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  }
}
